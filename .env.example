# Configuración Azure OpenAI para Análisis Inteligente
AZURE_OPENAI_ENDPOINT=https://orquestador-foundry.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_API_KEY_HERE
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Configuración Azure Storage (existente)
AzureStorageAccount__ConnectionString=YOUR_STORAGE_CONNECTION_STRING_HERE

# GitHub Token (opcional) – aumenta el límite de tasa de la API de GitHub de 60 a 5 000 peticiones/hora
# Genéralo en: https://github.com/settings/tokens (no necesita permisos especiales para repos públicos)
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
